generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  MEMBER
  ONBOARDING
  PARTNER_VIEWER
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Company {
  id                 String                    @id @default(cuid())
  name               String
  slug               String                    @unique
  status             CompanyStatus             @default(ACTIVE)
  createdAt          DateTime                  @default(now())
  teams              Team[]
  users              User[]
  invitations        Invitation[]
  stages             Stage[]
  leads              Lead[]
  activities         Activity[]
  tasks              Task[]
  attachments        Attachment[]
  accounts           Account[]
  accountActivities  AccountActivity[]
  accountTasks       AccountTask[]
  accountAsks        AccountAsk[]
  accountAttachments AccountAttachment[]
  settlementEntries  SettlementEntry[]
  accountFieldDefs   AccountFieldDef[]
  accountFieldValues AccountFieldValue[]
  serviceFees        ServiceFee[]
  installSnapshots   PlatformInstallSnapshot[]
  accountAssignments AccountAssignment[]
  onboardingSteps    OnboardingStep[]
}

// A sales team inside the one org (Qonshu). Each team has one COMPANY_ADMIN ("Team Admin" in the
// UI) plus MEMBERs, and owns its own Lead/Account book, its own Stage pipeline and its own
// AccountFieldDef set. Teams are the isolation boundary that Company used to be: a MEMBER sees
// only their OWN rows, a team admin sees their whole team, a SUPER_ADMIN sees everything.
model Team {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime          @default(now())
  users     User[]
  stages    Stage[]
  leads     Lead[]
  accounts  Account[]
  fieldDefs AccountFieldDef[]

  @@unique([companyId, name])
  @@index([companyId])
}

model User {
  id                      String                    @id @default(cuid())
  companyId               String?
  company                 Company?                  @relation(fields: [companyId], references: [id])
  // Null for SUPER_ADMIN (sees every team) and for PARTNER_VIEWER (scoped to one Account via
  // accountId, never to a team). Required in practice for COMPANY_ADMIN and MEMBER, but kept
  // nullable because the column cannot be NOT NULL while those two roles exist alongside them.
  teamId                  String?
  team                    Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  email                   String                    @unique
  passwordHash            String
  name                    String
  role                    Role
  status                  UserStatus                @default(ACTIVE)
  createdAt               DateTime                  @default(now())
  ownedLeads              Lead[]                    @relation("LeadOwner")
  managedAccounts         Account[]                 @relation("AccountManager")
  accountId               String?
  account                 Account?                  @relation(fields: [accountId], references: [id])
  createdInstallSnapshots PlatformInstallSnapshot[]
  accountAssignments      AccountAssignment[]

  @@index([companyId])
  @@index([accountId])
  @@index([companyId, teamId])
}

model Invitation {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  email       String
  role        Role
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String
  accountId   String?
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  @@index([companyId])
  @@index([token])
}

enum StageType {
  OPEN
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityKind {
  NOTE
  CALL
  MEETING
  EMAIL
  STAGE_CHANGE
}

model Stage {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // NULL means the ORG-LEVEL DEFAULT TEMPLATE: the stage set a newly created team is seeded
  // from. A non-null teamId is that team's own live pipeline. Template rows are never attached
  // to leads; only a team's own rows are.
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  type        StageType @default(OPEN)
  probability Int       @default(0)
  createdAt   DateTime  @default(now())
  leads       Lead[]

  @@index([companyId])
  @@index([companyId, teamId])
}

model Lead {
  id                String       @id @default(cuid())
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamId            String
  team              Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  // The BUILDING this lead is for, normalized, and the thing a team actually claims. Unique per
  // company, so one building is worked by exactly one team at a time. A LOST lead KEEPS its
  // claim (owner decision) — hence a plain unique index and deliberately NOT stage-aware
  // uniqueness. Recomputed by the app on every write from the same source the backfill used
  // (COALESCE(companyName, title)).
  buildingKey       String
  title             String
  contactName       String
  email             String?
  phone             String?
  companyName       String?
  source            String?
  priority          Priority     @default(MEDIUM)
  stageId           String
  stage             Stage        @relation(fields: [stageId], references: [id])
  ownerId           String
  owner             User         @relation("LeadOwner", fields: [ownerId], references: [id])
  expectedCloseDate DateTime?
  lostReason        String?
  // When this lead was WON, set once at the moment of the transition. Replaces the old
  // `updatedAt`-based "won in period" metric, which re-counted an old won lead into the current
  // period every time anyone edited it. Null for a lead that has never been won.
  wonAt             DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  activities        Activity[]
  tasks             Task[]
  attachments       Attachment[]

  @@unique([companyId, buildingKey])
  @@index([companyId])
  @@index([companyId, stageId])
  @@index([companyId, ownerId])
  @@index([companyId, teamId])
  @@index([teamId, ownerId])
  @@index([companyId, wonAt])
}

model Activity {
  id         String       @id @default(cuid())
  companyId  String
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId   String?
  kind       ActivityKind @default(NOTE)
  body       String
  outcome    String?
  occurredAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  @@index([companyId, leadId])
}

model Task {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title      String
  dueDate    DateTime?
  done       Boolean   @default(false)
  assigneeId String?
  createdAt  DateTime  @default(now())

  @@index([companyId, leadId])
  @@index([companyId, assigneeId])
}

model Attachment {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  filename     String
  diskPath     String
  size         Int
  mime         String
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([companyId, leadId])
}

enum AccountStatus {
  DEMO
  ACTIVE
  AT_RISK
  CHURNED
}

enum AccountActivityKind {
  NOTE
  CALL
  MEETING
  EMAIL
}

enum AskStatus {
  OPEN
  RESOLVED
}

model Account {
  id                      String                    @id @default(cuid())
  companyId               String
  company                 Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamId                  String
  team                    Team                      @relation(fields: [teamId], references: [id], onDelete: Restrict)
  name                    String
  // Same building claim as Lead.buildingKey, carried across conversion: a won lead's key becomes
  // its account's key, so the building stays claimed by the one team that sold it. Unique per
  // company. Lead and Account hold SEPARATE unique indexes, so a won lead and the account it
  // became legitimately share a key.
  buildingKey             String
  website                 String?
  industry                String?
  // Manually-entered key that maps this account to the partner company as known to the
  // external analytics API (matched by company name per the partner API contract). The real
  // PartnerAnalyticsSource fetches by THIS key, not the display name, so renaming the account
  // never mis-routes another partner's data onto it. Null => not yet linked => syncs nothing.
  //
  // NON-NULL MEANS "A LINK EXISTS", NOT "A LINK IS LIVE". Read it together with
  // partnerLinkConfirmedAt below: the pair is a two-state machine and only the confirmed state
  // authorizes anything.
  externalPartnerKey      String?
  // WHEN THE LINK WAS CONFIRMED. Null while externalPartnerKey is non-null = PENDING.
  //
  // WHY THIS COLUMN EXISTS (security review finding F1): dropping PartnerAllowlist swapped an
  // ENTITLEMENT check ("may Qonshu read this complex's data at all?") for a CONTENTION check
  // ("has anyone here claimed it?"). Nothing answered the first question any more, so a plain
  // MEMBER could name a guessed building, have the account auto-link off the live upstream list,
  // and read that complex's debt, payments and — via the Objects tab — every unit's owner name
  // and phone number, including buildings Qonshu has no contract with.
  //
  // So naming a building still records the claim (that is what stops two members pending one
  // building), but the link grants NOTHING until it is confirmed on /partner-links — by the
  // account team's own admin, or by the owner, and NEVER by the person who proposed it
  // (partnerLinkProposedById below).
  //
  // resolvePartnerCredentials (src/lib/partner-api/credentials.ts) is the single chokepoint that
  // enforces it: a pending link resolves to null and every consumer renders "not configured".
  //
  // Set by: confirm (a team admin for their own team, or a super admin anywhere) and the
  // SUPER_ADMIN direct assign. Cleared with the key by: reject and clear.
  partnerLinkConfirmedAt  DateTime?
  // WHO PROPOSED THE PENDING LINK — the user whose account-create or rename staked it.
  //
  // This exists to enforce a TWO-PERSON RULE: nobody may confirm a link they themselves proposed.
  // A COMPANY_ADMIN is also a salesperson, so without this an admin could name any building and
  // immediately approve their own access to that complex's debt, payments and unit owners —
  // leaving the gate with one person on both sides of it. A SUPER_ADMIN is exempt: they are the
  // last resort, and without that exemption a link they proposed would be unapprovable by anyone.
  //
  // READ AS AUTHORIZATION INPUT, so it is stored here rather than derived from PartnerLinkAudit.
  // The audit is a log — rows can be filtered on read and an account can be re-proposed — and
  // "who may act now" must come from current state, not from a query over history.
  //
  // A BARE String WITH NO RELATION, deliberately, matching PartnerLinkAudit.actorId: this must not
  // acquire a cascade or a RESTRICT that makes deleting a user depend on partner-link state. A
  // dangling id is harmless — it matches no live actor, so it blocks nobody.
  //
  // Null means "no proposer on record": an unlinked account, a link the SUPER_ADMIN assigned
  // directly, or a confirmed link that predates this column (see the migration's backfill note).
  // Cleared on reject; KEPT on confirm, so the record of who asked survives the approval.
  partnerLinkProposedById String?
  // Ciphertext of the secret X-API-Key used to authenticate to the partner's Django backend
  // (encryption performed by the integration layer, not by this model). Nullable until linked.
  externalApiKeyEnc       String?
  // Last 4 chars of the plaintext key, kept alongside the ciphertext for masked display
  // (e.g. "•••• 9f3a") without ever decrypting the secret for the UI.
  externalApiKeyLast4     String?
  status                  AccountStatus             @default(ACTIVE)
  // DEMO / trial window, as calendar days (@db.Date, not timestamps: a timestamp would give
  // time-zone off-by-one errors in "42 days left").
  // A CHECK constraint "Account_demo_trial_dates_check" exists in the migration
  // 20261124090100_demo_trials_assignments_onboarding enforcing: status = DEMO requires both
  // trial dates, and trialEndsAt >= trialStartsAt. Prisma does not model CHECK constraints, so it
  // will NOT show up in this schema or in `migrate diff`.
  trialStartsAt           DateTime?                 @db.Date
  trialEndsAt             DateTime?                 @db.Date
  // null = unknown / not yet asked. Drives whether the payment-provider onboarding step applies.
  takesOnlinePayments     Boolean?
  // Idempotency claim for seeding the onboarding checklist (set once, when the account first
  // becomes ACTIVE). Pre-existing accounts were backfilled to createdAt: already past onboarding.
  onboardingSeededAt      DateTime?
  accountManagerId        String
  accountManager          User                      @relation("AccountManager", fields: [accountManagerId], references: [id], onDelete: Restrict)
  primaryContactName      String?
  primaryContactEmail     String?
  primaryContactPhone     String?
  sourceLeadId            String?                   @unique
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  activities              AccountActivity[]
  tasks                   AccountTask[]
  asks                    AccountAsk[]
  attachments             AccountAttachment[]
  settlementEntries       SettlementEntry[]
  fieldValues             AccountFieldValue[]
  serviceFees             ServiceFee[]
  partnerUsers            User[]
  installSnapshots        PlatformInstallSnapshot[]
  partnerLinkAudits       PartnerLinkAudit[]
  assignments             AccountAssignment[]
  onboardingSteps         OnboardingStep[]

  // DB backstop for the GLOBAL partner namespace: one shared X-API-Key means `?partner=<name>`
  // addresses the same upstream complex for every tenant, so two accounts holding one name
  // double-count every analytics fan-out AND cross-expose two companies' debt/payments/unit
  // owners. Every claim path (auto-link, SUPER_ADMIN assign) is check-then-act and therefore
  // racy on its own; this constraint is what actually makes a double claim impossible. Postgres
  // ignores NULLs in a unique index, so any number of unlinked accounts coexist.
  @@unique([externalPartnerKey])
  @@unique([companyId, buildingKey])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, status, trialEndsAt])
  @@index([companyId, accountManagerId])
  @@index([companyId, teamId])
  @@index([teamId, accountManagerId])
}

model AccountActivity {
  id         String              @id @default(cuid())
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId   String?
  kind       AccountActivityKind @default(NOTE)
  body       String
  outcome    String?
  occurredAt DateTime            @default(now())
  createdAt  DateTime            @default(now())

  @@index([companyId, accountId])
}

model AccountTask {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title      String
  dueDate    DateTime?
  done       Boolean   @default(false)
  assigneeId String?
  createdAt  DateTime  @default(now())

  @@index([companyId, accountId])
}

model AccountAsk {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title      String
  detail     String?
  status     AskStatus @default(OPEN)
  authorId   String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([companyId, accountId])
}

model AccountAttachment {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filename     String
  diskPath     String
  size         Int
  mime         String
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([companyId, accountId])
}

enum AppPlatform {
  IOS
  ANDROID
  UNKNOWN
}

// One row per account per day recording that day's manually-entered app-download counts
// (iOS + Android), so an installs-over-time chart can be built without a live analytics feed.
model PlatformInstallSnapshot {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  capturedOn      DateTime @db.Date
  iosInstalls     Int
  androidInstalls Int
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())

  @@unique([accountId, capturedOn])
  @@index([companyId, capturedOn])
}

// DURABLE audit trail for the most security-sensitive write in the app: which account points at
// which external complex (Account.externalPartnerKey), over a namespace shared by everyone.
//
// WHY A DEDICATED TABLE: this trail used to live in AccountActivity, which is cascade-deleted
// with its account. Deleting the account therefore destroyed the record of who had linked it to
// which complex — exactly the question an audit exists to answer, and exactly the record someone
// covering their tracks would want gone. This table is deliberately attached to NOTHING that
// cascades:
//   - `accountId` is a NULLABLE FK with onDelete: SetNull, so the row outlives its account.
//   - `companyId` is a BARE String with no relation (same convention as AccountActivity.authorId
//     and SettlementEntry.createdById), so the row also outlives its company.
//   - `actorId` is likewise bare, so it survives the deletion of the user who acted.
// Nothing anywhere declares a cascade into this table. Do not add one.
//
// Because the FK can go null and the actor/company are unresolvable joins, every field needed to
// READ the row later is DENORMALIZED at write time: accountName, partnerName and actorEmail are
// snapshots of what was true when the link changed, not live lookups. They are intentionally NOT
// kept in sync if the account or user is later renamed — the audit records what the admin saw.
model PartnerLinkAudit {
  id          String   @id @default(cuid())
  // Bare String, no relation: see header. The company this account belonged to when the link
  // changed.
  companyId   String
  // Goes NULL when the account is deleted; the row and its denormalized copy remain.
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  // Snapshot of Account.name at write time — the only readable identification of the account
  // once accountId is null.
  accountName String
  // The external complex involved. For a "clear" this is the name the link HELD before being
  // cleared, which is otherwise unrecoverable (the column becomes null). Null only when a clear
  // found nothing linked.
  partnerName String?
  // One of PartnerLinkAction in src/lib/tenant/partner-link-audit.ts: "auto_link" | "assign" |
  // "clear". A String rather than a DB enum so a later action can be added without a migration,
  // matching how AccountActivity.outcome already encodes this vocabulary.
  action      String
  // Bare String, no relation: see header. Null for a system action with no human behind it.
  actorId     String?
  // Snapshot of the actor's email, so the row still names a person after that user is deleted.
  actorEmail  String?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([accountId])
}

enum SettlementType {
  COLLECTED
  TRANSFER
}

enum SettlementMethod {
  CASH
  BANK_TRANSFER
  MANUAL
}

model SettlementEntry {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        SettlementType
  amount      Decimal
  method      SettlementMethod
  occurredAt  DateTime
  note        String?
  createdById String
  createdAt   DateTime         @default(now())

  @@index([companyId, accountId])
  @@index([companyId, type])
}

enum AccountFieldType {
  TEXT
  NUMBER
  CURRENCY
  DATE
}

model AccountFieldDef {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // NULL means the ORG-LEVEL DEFAULT TEMPLATE that a new team's field set is seeded from; a
  // non-null teamId is that team's own live definition. Template rows never carry values.
  teamId    String?
  team      Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  label     String
  type      AccountFieldType
  order     Int
  createdAt DateTime            @default(now())
  values    AccountFieldValue[]

  // Scoped to the TEAM, not the company: two teams may each have a "Total area" field.
  // CAVEAT: Postgres treats NULLs as DISTINCT in a unique index, so this constraint does NOT
  // police the org-level template (teamId IS NULL) — duplicate template labels are possible at
  // the DB level and MUST be rejected in app code. A partial unique index on (label) WHERE
  // teamId IS NULL would close that, but Prisma cannot express one, so it is an app-layer rule.
  @@unique([teamId, label])
  @@index([companyId])
  @@index([companyId, teamId])
}

model AccountFieldValue {
  id         String          @id @default(cuid())
  companyId  String
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fieldDefId String
  fieldDef   AccountFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)
  value      String
  updatedAt  DateTime        @updatedAt

  @@unique([accountId, fieldDefId])
  @@index([companyId, accountId])
}

enum ServiceFeeStatus {
  UNPAID
  PAID
}

model ServiceFee {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodMonth DateTime
  amount      Decimal
  dueDate     DateTime?
  status      ServiceFeeStatus  @default(UNPAID)
  paidAt      DateTime?
  method      SettlementMethod?
  note        String?
  createdById String
  createdAt   DateTime          @default(now())

  @@unique([accountId, periodMonth])
  @@index([companyId, status])
  @@index([companyId, accountId])
}

// AUTHORIZATION INPUT: a row here grants `userId` access to building `accountId` (the ONBOARDING
// role's access comes entirely from these rows). Writes are therefore admin-only, enforced in the
// service layer. onDelete: Cascade on `user` is intended: deleting a user must revoke their access.
// createdById is an informational bare id (no relation), so it never blocks a user delete.
model AccountAssignment {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([accountId, userId])
  @@index([userId, accountId])
}

// One row of a building's post-contract onboarding checklist. templateKey is null for a one-off
// custom step. user ids (completedById, assigneeId, createdById) are bare ids with NO relation,
// deliberately (same convention as AccountTask.assigneeId): deleting a user is never blocked by,
// nor cascades through, this data.
model OnboardingStep {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  templateKey   String?
  title         String
  position      Int
  done          Boolean   @default(false)
  completedById String?
  completedAt   DateTime?
  assigneeId    String?
  dueDate       DateTime? @db.Date
  note          String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // DB-level backstop against seeding the checklist twice. Postgres allows multiple NULLs, so any
  // number of custom (templateKey null) steps coexist.
  @@unique([accountId, templateKey])
  @@index([accountId, position])
  @@index([companyId, assigneeId, done])
}
