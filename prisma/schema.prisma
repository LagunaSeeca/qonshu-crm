generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  MEMBER
  PARTNER_VIEWER
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Company {
  id                  String              @id @default(cuid())
  name                String
  slug                String              @unique
  status              CompanyStatus       @default(ACTIVE)
  shareAllLeads       Boolean             @default(true)
  createdAt           DateTime            @default(now())
  users               User[]
  invitations         Invitation[]
  stages              Stage[]
  leads               Lead[]
  activities          Activity[]
  tasks               Task[]
  attachments         Attachment[]
  accounts            Account[]
  accountActivities   AccountActivity[]
  accountTasks        AccountTask[]
  accountAsks         AccountAsk[]
  accountAttachments  AccountAttachment[]
  settlementEntries   SettlementEntry[]
  accountFieldDefs    AccountFieldDef[]
  accountFieldValues  AccountFieldValue[]
  serviceFees         ServiceFee[]
  installSnapshots    PlatformInstallSnapshot[]
  partnerAllowlist    PartnerAllowlist[]
}

model User {
  id           String     @id @default(cuid())
  companyId    String?
  company      Company?   @relation(fields: [companyId], references: [id])
  email        String     @unique
  passwordHash String
  name         String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  ownedLeads   Lead[]     @relation("LeadOwner")
  accountId    String?
  account      Account?   @relation(fields: [accountId], references: [id])
  createdInstallSnapshots PlatformInstallSnapshot[]

  @@index([companyId])
  @@index([accountId])
}

model Invitation {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  email       String
  role        Role
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String
  accountId   String?
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  @@index([companyId])
  @@index([token])
}

enum StageType {
  OPEN
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityKind {
  NOTE
  CALL
  MEETING
  EMAIL
  STAGE_CHANGE
}

model Stage {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  type        StageType @default(OPEN)
  probability Int       @default(0)
  createdAt   DateTime  @default(now())
  leads       Lead[]
  @@index([companyId])
}

model Lead {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title             String
  contactName       String
  email             String?
  phone             String?
  companyName       String?
  source            String?
  priority          Priority  @default(MEDIUM)
  stageId           String
  stage             Stage     @relation(fields: [stageId], references: [id])
  ownerId           String
  owner             User      @relation("LeadOwner", fields: [ownerId], references: [id])
  expectedCloseDate DateTime?
  lostReason        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  activities        Activity[]
  tasks             Task[]
  attachments       Attachment[]
  @@index([companyId])
  @@index([companyId, stageId])
  @@index([companyId, ownerId])
}

model Activity {
  id         String       @id @default(cuid())
  companyId  String
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId   String?
  kind       ActivityKind @default(NOTE)
  body       String
  outcome    String?
  occurredAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
  @@index([companyId, leadId])
}

model Task {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title      String
  dueDate    DateTime?
  done       Boolean  @default(false)
  assigneeId String?
  createdAt  DateTime @default(now())
  @@index([companyId, leadId])
  @@index([companyId, assigneeId])
}

model Attachment {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  filename     String
  diskPath     String
  size         Int
  mime         String
  uploadedById String
  createdAt    DateTime @default(now())
  @@index([companyId, leadId])
}

enum AccountStatus {
  ACTIVE
  AT_RISK
  CHURNED
}

enum AccountActivityKind {
  NOTE
  CALL
  MEETING
  EMAIL
}

enum AskStatus {
  OPEN
  RESOLVED
}

model Account {
  id                  String        @id @default(cuid())
  companyId           String
  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  website             String?
  industry            String?
  // Manually-entered key that maps this account to the partner company as known to the
  // external analytics API (matched by company name per the partner API contract). The real
  // PartnerAnalyticsSource fetches by THIS key, not the display name, so renaming the account
  // never mis-routes another partner's data onto it. Null => not yet linked => syncs nothing.
  externalPartnerKey  String?
  // Ciphertext of the secret X-API-Key used to authenticate to the partner's Django backend
  // (encryption performed by the integration layer, not by this model). Nullable until linked.
  externalApiKeyEnc   String?
  // Last 4 chars of the plaintext key, kept alongside the ciphertext for masked display
  // (e.g. "•••• 9f3a") without ever decrypting the secret for the UI.
  externalApiKeyLast4 String?
  status              AccountStatus @default(ACTIVE)
  accountManagerId    String
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  sourceLeadId        String?       @unique
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  activities          AccountActivity[]
  tasks               AccountTask[]
  asks                AccountAsk[]
  attachments         AccountAttachment[]
  settlementEntries   SettlementEntry[]
  fieldValues         AccountFieldValue[]
  serviceFees         ServiceFee[]
  partnerUsers        User[]
  installSnapshots    PlatformInstallSnapshot[]
  // DB backstop for the GLOBAL partner namespace: one shared X-API-Key means `?partner=<name>`
  // addresses the same upstream complex for every tenant, so two accounts holding one name
  // double-count every analytics fan-out AND cross-expose two companies' debt/payments/unit
  // owners. Every claim path (auto-link, SUPER_ADMIN assign) is check-then-act and therefore
  // racy on its own; this constraint is what actually makes a double claim impossible. Postgres
  // ignores NULLs in a unique index, so any number of unlinked accounts coexist.
  @@unique([externalPartnerKey])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, accountManagerId])
}

model AccountActivity {
  id         String              @id @default(cuid())
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId   String?
  kind       AccountActivityKind @default(NOTE)
  body       String
  outcome    String?
  occurredAt DateTime            @default(now())
  createdAt  DateTime            @default(now())
  @@index([companyId, accountId])
}

model AccountTask {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title      String
  dueDate    DateTime?
  done       Boolean  @default(false)
  assigneeId String?
  createdAt  DateTime @default(now())
  @@index([companyId, accountId])
}

model AccountAsk {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title      String
  detail     String?
  status     AskStatus @default(OPEN)
  authorId   String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  @@index([companyId, accountId])
}

model AccountAttachment {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filename     String
  diskPath     String
  size         Int
  mime         String
  uploadedById String
  createdAt    DateTime @default(now())
  @@index([companyId, accountId])
}

enum AppPlatform {
  IOS
  ANDROID
  UNKNOWN
}

// One row per account per day recording that day's manually-entered app-download counts
// (iOS + Android), so an installs-over-time chart can be built without a live analytics feed.
model PlatformInstallSnapshot {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  capturedOn      DateTime @db.Date
  iosInstalls     Int
  androidInstalls Int
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  @@unique([accountId, capturedOn])
  @@index([companyId, capturedOn])
}

// SUPER_ADMIN-managed authorization table: which company is allowed to auto-link to which
// external partner (complex). WHY IT EXISTS: auto-link used to resolve a partner from the
// account NAME — free text the tenant supplies — so any MEMBER could create an account named
// after another tenant's complex and claim it, and the 201 response confirmed the hit, making
// account creation an enumeration oracle over the global partner namespace. Auto-link is now a
// LOOKUP against this table instead of a CLAIM on a name, and a name that isn't allowlisted to
// the caller's company is indistinguishable from a name that doesn't exist at all.
//
// NORMALIZATION: `partnerName` stores the EXACT upstream name (it is what gets sent as
// `?partner=` and persisted to Account.externalPartnerKey); `normalizedName` is the trimmed,
// lowercased form and is the ONLY column looked up by. Both are unique, so one complex can be
// granted to at most one company however it is cased.
//
// createdById is a bare String (no relation), matching AccountActivity.authorId: it records
// which super admin added the grant without making the row depend on that user still existing.
model PartnerAllowlist {
  id             String   @id @default(cuid())
  partnerName    String   @unique
  normalizedName String   @unique
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById    String?
  createdAt      DateTime @default(now())
  @@index([companyId])
}

enum SettlementType {
  COLLECTED
  TRANSFER
}
enum SettlementMethod {
  CASH
  BANK_TRANSFER
  MANUAL
}

model SettlementEntry {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        SettlementType
  amount      Decimal
  method      SettlementMethod
  occurredAt  DateTime
  note        String?
  createdById String
  createdAt   DateTime          @default(now())
  @@index([companyId, accountId])
  @@index([companyId, type])
}

enum AccountFieldType {
  TEXT
  NUMBER
  CURRENCY
  DATE
}

model AccountFieldDef {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label     String
  type      AccountFieldType
  order     Int
  createdAt DateTime            @default(now())
  values    AccountFieldValue[]
  @@unique([companyId, label])
  @@index([companyId])
}

model AccountFieldValue {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fieldDefId  String
  fieldDef    AccountFieldDef  @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)
  value       String
  updatedAt   DateTime         @updatedAt
  @@unique([accountId, fieldDefId])
  @@index([companyId, accountId])
}

enum ServiceFeeStatus {
  UNPAID
  PAID
}

model ServiceFee {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodMonth DateTime
  amount      Decimal
  dueDate     DateTime?
  status      ServiceFeeStatus  @default(UNPAID)
  paidAt      DateTime?
  method      SettlementMethod?
  note        String?
  createdById String
  createdAt   DateTime          @default(now())
  @@unique([accountId, periodMonth])
  @@index([companyId, status])
  @@index([companyId, accountId])
}
